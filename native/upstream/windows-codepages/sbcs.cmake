# Embeds the byte table and the best-fit table of each single-byte code page text in PAGES (from SOURCE) into OUTPUT.
string(REPLACE "," ";" PAGES "${PAGES}")
set(CONTENT "#pragma once\n#include <array>\n#include <cstdint>\nnamespace raven {\n")
set(LIST "")
foreach(PAGE IN LISTS PAGES)
    set(MODE "")
    set(BYTES "")
    set(FITS "")
    # An OEM page comes as Unicode's byte-to-character table alone: it converts back exactly, with no best fit.
    if(NOT EXISTS "${SOURCE}/c_${PAGE}.txt")
        file(STRINGS "${SOURCE}/CP${PAGE}.TXT" LINES)
        foreach(LINE IN LISTS LINES)
            string(REGEX REPLACE "#.*" "" LINE "${LINE}")
            string(STRIP "${LINE}" LINE)
            if(LINE MATCHES "^0x([0-9a-fA-F][0-9a-fA-F])[ \t]+0x([0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F])$")
                string(TOLOWER "${CMAKE_MATCH_1}" FROM)
                string(TOLOWER "${CMAKE_MATCH_2}" TO)
                list(APPEND BYTES "0x${TO}")
                list(APPEND FITS "${TO}:${FROM}")
            elseif(LINE)
                message(FATAL_ERROR "CP${PAGE}.TXT has an unexpected line: ${LINE}")
            endif()
        endforeach()
        set(LINES "")
    else()
        file(STRINGS "${SOURCE}/c_${PAGE}.txt" LINES)
    endif()
    foreach(LINE IN LISTS LINES)
        string(REGEX REPLACE ";.*" "" LINE "${LINE}")
        string(STRIP "${LINE}" LINE)
        if(LINE MATCHES "^(MBTABLE|WCTABLE|CPINFO|CODEPAGE|ENDCODEPAGE|DBCSRANGE|DBCSTABLE)")
            set(MODE "${CMAKE_MATCH_1}")
            if(MODE STREQUAL "DBCSRANGE" OR MODE STREQUAL "DBCSTABLE")
                message(FATAL_ERROR "c_${PAGE}.txt is not a single-byte code page")
            endif()
        elseif(LINE MATCHES "^0x([0-9a-fA-F]+)[ \t]+0x([0-9a-fA-F]+)$")
            string(TOLOWER "${CMAKE_MATCH_1}" FROM)
            string(TOLOWER "${CMAKE_MATCH_2}" TO)
            if(MODE STREQUAL "MBTABLE")
                list(APPEND BYTES "0x${TO}")
            elseif(MODE STREQUAL "WCTABLE")
                # Four hex digits sort as text in Unicode order.
                string(LENGTH "${FROM}" WIDTH)
                if(NOT WIDTH EQUAL 4)
                    message(FATAL_ERROR "c_${PAGE}.txt has an unexpected best-fit entry ${FROM}")
                endif()
                list(APPEND FITS "${FROM}:${TO}")
            endif()
        elseif(LINE)
            message(FATAL_ERROR "c_${PAGE}.txt has an unexpected line: ${LINE}")
        endif()
    endforeach()
    list(LENGTH BYTES BYTE_COUNT)
    if(NOT BYTE_COUNT EQUAL 256)
        message(FATAL_ERROR "c_${PAGE}.txt maps ${BYTE_COUNT} bytes")
    endif()
    list(SORT FITS)
    list(LENGTH FITS FIT_COUNT)
    list(JOIN BYTES "," BYTE_TEXT)
    string(APPEND CONTENT "inline constexpr std::array<uint16_t,256> native_mb${PAGE}{${BYTE_TEXT}};\n")
    string(APPEND CONTENT "inline constexpr std::array<std::array<uint16_t,2>,${FIT_COUNT}> native_wc${PAGE}{{\n")
    foreach(FIT IN LISTS FITS)
        string(REPLACE ":" ",0x" FIT "${FIT}")
        string(APPEND CONTENT "\t{0x${FIT}},\n")
    endforeach()
    string(APPEND CONTENT "}};\n")
    string(APPEND LIST "\t{${PAGE},native_mb${PAGE}.data(),native_wc${PAGE}.data(),native_wc${PAGE}.size()},\n")
endforeach()
string(APPEND CONTENT "inline constexpr NativeSingleBytePage native_single_byte_pages[]{\n${LIST}};\n}\n")
file(WRITE "${OUTPUT}" "${CONTENT}")
