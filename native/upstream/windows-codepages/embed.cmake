file(SHA256 "${INPUT}" NLS_HASH)
if(NOT NLS_HASH STREQUAL "e2634ee32da7977d762d2d45be2053309ee718572a7d8bb0034180dc1b0b6b76")
    message(FATAL_ERROR "Generated CP1252 table differs from the qualified input")
endif()
file(READ "${INPUT}" NLS_HEX HEX)
string(SUBSTRING "${NLS_HEX}" 1092 131072 TABLE_HEX)
set(CONTENT "#pragma once\n#include <array>\n#include <cstdint>\nnamespace raven {\ninline constexpr std::array<uint8_t,65536> native_cp1252{\n")
foreach(ROW RANGE 0 4095)
    math(EXPR OFFSET "${ROW} * 32")
    string(SUBSTRING "${TABLE_HEX}" ${OFFSET} 32 LINE)
    string(REGEX REPLACE "(..)" "0x\\1," LINE "${LINE}")
    string(APPEND CONTENT "\t${LINE}\n")
endforeach()
string(APPEND CONTENT "};\ninline constexpr std::array<uint16_t,256> native_mb1252{\n")
string(SUBSTRING "${NLS_HEX}" 56 1024 MB_HEX)
foreach(INDEX RANGE 0 255)
    math(EXPR OFFSET "${INDEX} * 4")
    math(EXPR HIGH_OFFSET "${OFFSET} + 2")
    string(SUBSTRING "${MB_HEX}" ${OFFSET} 2 LOW)
    string(SUBSTRING "${MB_HEX}" ${HIGH_OFFSET} 2 HIGH)
    string(APPEND CONTENT "\t0x${HIGH}${LOW},\n")
endforeach()
string(APPEND CONTENT "};\n}\n")
file(WRITE "${OUTPUT}" "${CONTENT}")
